# Скопируйте этот файл в .env и заполните реальными значениями.
# Генерация SECRET_KEY (64 hex-символа):
#   python3 -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=c3aa62d919d1e2f1da7d9d25987ee6edecff9432bd0a8e45f144e2acc5a70ecd

# Абсолютный путь к файлу базы данных SQLite
DATABASE_PATH=/var/www/konkurs/konkurs.db

# production | development
FLASK_ENV=production

# Secure-флаг cookie сессии (1 — только HTTPS). В продакшене обязательно 1.
SESSION_COOKIE_SECURE=1

# Необязательно: e-mail администратора для алертов/уведомлений
ADMIN_EMAIL=admin@example.com
